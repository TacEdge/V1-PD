  <Shot file="/screenshots/v1-workflows/WF-01-S05-dashboard-field-mobile.png" caption="Mobile field surface + bottom nav." cls="OBSERVED" viewport="mobile" />
  <Shot file="/screenshots/v1-workflows/WF-13-S01-voice-dialog-desktop.png" caption="Voice surface — Quick Voice Report (extraction blocked)." cls="PARTIALLY OBSERVED" />
