    <tr><td>Field</td><td>FieldTech · Subcontractor</td><td>Drill, Daily Activity, Notes, safety-lite, Forms, My Submissions — must pick a project on Drill</td><td>Mobile</td></tr>
    <tr><td>Viewer</td><td>ClientViewer</td><td>Read-only surfaces</td><td>Desktop</td></tr>
  </tbody>
</table></div>
<div class="strip">
  <Shot file="/screenshots/v1-workflows/WF-01-S02-dashboard-admin-desktop.png" caption="Management (OrgAdmin) — full navigation." cls="OBSERVED — TEST DATA" />
  <Shot file="/screenshots/v1-workflows/WF-01-S04-dashboard-field-desktop.png" caption="Field — capture-focused navigation." cls="OBSERVED" />
  <Shot file="/screenshots/v1-workflows/WF-01-S04b-dashboard-viewer-desktop.png" caption="Viewer — read-only." cls="OBSERVED" />
</div>
